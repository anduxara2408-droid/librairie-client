<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Admin - MAURILIVRES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>" />

    <style>
        /* ============================================================
               STYLES ADMIN
               ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f2f5;
            color: #1a1a2e;
            padding: 20px;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ===== HEADER ADMIN ===== */
        .admin-header {
            background: #fff;
            padding: 20px 30px;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .admin-header .logo h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
        }
        .admin-header .logo h1 i {
            color: #145daa;
            margin-right: 10px;
        }
        .admin-header .logo .subtitle {
            font-size: 0.8rem;
            color: #6c757d;
            font-weight: 400;
        }
        .admin-header .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }
        .admin-header .header-actions .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .admin-header .header-actions .btn-primary {
            background: #145daa;
            color: #fff;
        }
        .admin-header .header-actions .btn-primary:hover {
            background: #0d4a8a;
            transform: translateY(-2px);
        }
        .admin-header .header-actions .btn-success {
            background: #28a745;
            color: #fff;
        }
        .admin-header .header-actions .btn-success:hover {
            background: #1e7e34;
            transform: translateY(-2px);
        }
        .admin-header .header-actions .btn-danger {
            background: #dc3545;
            color: #fff;
        }
        .admin-header .header-actions .btn-danger:hover {
            background: #bd2130;
            transform: translateY(-2px);
        }
        .admin-header .header-actions .btn-outline {
            background: transparent;
            color: #145daa;
            border: 2px solid #145daa;
        }
        .admin-header .header-actions .btn-outline:hover {
            background: #145daa;
            color: #fff;
        }

        /* ===== STATS ===== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #fff;
            padding: 20px 25px;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }
        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #145daa;
        }
        .stat-card .stat-label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 4px;
        }
        .stat-card .stat-icon {
            float: right;
            font-size: 2rem;
            color: #e9ecef;
        }
        .stat-card .stat-change {
            font-size: 0.8rem;
            font-weight: 600;
            margin-top: 6px;
            display: inline-block;
            padding: 2px 10px;
            border-radius: 20px;
        }
        .stat-card .stat-change.up {
            background: #d4edda;
            color: #155724;
        }
        .stat-card .stat-change.down {
            background: #f8d7da;
            color: #721c24;
        }

        /* ===== TABLEAU ===== */
        .table-container {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            overflow: hidden;
        }
        .table-container .table-toolbar {
            padding: 18px 24px;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        .table-container .table-toolbar h2 {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1a1a2e;
        }
        .table-container .table-toolbar h2 i {
            color: #145daa;
            margin-right: 8px;
        }
        .table-container .table-toolbar .search-box {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .table-container .table-toolbar .search-box input {
            padding: 8px 14px;
            border: 1px solid #ced4da;
            border-radius: 10px;
            font-size: 0.9rem;
            min-width: 200px;
            transition: border 0.3s;
        }
        .table-container .table-toolbar .search-box input:focus {
            outline: 2px solid #145daa;
            border-color: transparent;
        }
        .table-container .table-toolbar .search-box select {
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 10px;
            font-size: 0.9rem;
            background: #fff;
            cursor: pointer;
        }

        .table-wrapper {
            overflow-x: auto;
            padding: 0 4px 4px 4px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        table thead {
            background: #f8f9fa;
        }
        table th {
            padding: 14px 16px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            font-weight: 700;
            border-bottom: 2px solid #e9ecef;
            white-space: nowrap;
        }
        table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
        }
        table tr:hover {
            background: #f8f9fa;
        }
        table .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        table .badge-active {
            background: #d4edda;
            color: #155724;
        }
        table .badge-inactive {
            background: #f8d7da;
            color: #721c24;
        }
        table .badge-orders {
            background: #e8f0fe;
            color: #145daa;
        }
        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #145daa;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
        }
        .user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .user-cell .user-info {
            display: flex;
            flex-direction: column;
        }
        .user-cell .user-info .name {
            font-weight: 600;
            color: #1a1a2e;
        }
        .user-cell .user-info .email {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }
        .loading i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 12px;
            color: #145daa;
        }
        .empty {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }
        .empty i {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
            color: #ced4da;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 6px;
            padding: 16px;
            border-top: 1px solid #e9ecef;
        }
        .pagination button {
            padding: 6px 14px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            background: #fff;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.85rem;
        }
        .pagination button:hover {
            background: #f8f9fa;
        }
        .pagination button.active {
            background: #145daa;
            color: #fff;
            border-color: #145daa;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            body {
                padding: 10px;
            }
            .admin-header {
                flex-direction: column;
                text-align: center;
                padding: 15px 20px;
            }
            .admin-header .header-actions {
                justify-content: center;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
            .stat-card {
                padding: 15px;
            }
            .stat-card .stat-number {
                font-size: 1.5rem;
            }
            .table-container .table-toolbar {
                flex-direction: column;
                align-items: stretch;
            }
            .table-container .table-toolbar .search-box {
                flex-wrap: wrap;
            }
            .table-container .table-toolbar .search-box input {
                min-width: 100%;
            }
            table {
                font-size: 0.8rem;
            }
            table th, table td {
                padding: 10px 12px;
            }
            .user-cell .user-info .email {
                font-size: 0.7rem;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }
            .stat-card .stat-number {
                font-size: 1.2rem;
            }
            .stat-card .stat-label {
                font-size: 0.7rem;
            }
        }

        /* ===== TOAST ===== */
        .toast-admin {
            position: fixed;
            bottom: 30px;
            right: 30px;
            padding: 14px 24px;
            border-radius: 12px;
            color: #fff;
            font-weight: 500;
            font-size: 0.9rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            z-index: 999999;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s;
            max-width: 400px;
        }
        .toast-admin.show {
            opacity: 1;
            transform: translateY(0);
        }
        .toast-admin.success {
            background: #28a745;
        }
        .toast-admin.error {
            background: #dc3545;
        }
        .toast-admin.info {
            background: #17a2b8;
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- ===== HEADER ===== -->
        <div class="admin-header">
            <div class="logo">
                <h1><i class="fas fa-users-cog"></i> Administration MAURILIVRES</h1>
                <div class="subtitle">Gestion des utilisateurs et des commandes</div>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline" onclick="refreshData()">
                    <i class="fas fa-sync-alt"></i> Actualiser
                </button>
                <button class="btn btn-success" onclick="exportUsers()">
                    <i class="fas fa-file-download"></i> Exporter CSV
                </button>
                <button class="btn btn-danger" onclick="logoutAdmin()">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </button>
            </div>
        </div>

        <!-- ===== STATS ===== -->
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-number" id="statUsers">0</div>
                <div class="stat-label">Total Utilisateurs</div>
                <div class="stat-change up" id="statUsersChange">+0 aujourd'hui</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
                <div class="stat-number" id="statOrders">0</div>
                <div class="stat-label">Total Commandes</div>
                <div class="stat-change up" id="statOrdersChange">+0 cette semaine</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-heart"></i></div>
                <div class="stat-number" id="statFavorites">0</div>
                <div class="stat-label">Favoris ajoutés</div>
                <div class="stat-change up" id="statFavoritesChange">+0</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="stat-number" id="statToday">0</div>
                <div class="stat-label">Inscriptions aujourd'hui</div>
                <div class="stat-change up" id="statTodayChange">📈</div>
            </div>
        </div>

        <!-- ===== TABLEAU ===== -->
        <div class="table-container">
            <div class="table-toolbar">
                <h2><i class="fas fa-list"></i> Liste des utilisateurs</h2>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="🔍 Rechercher un utilisateur..." oninput="filterUsers()" />
                    <select id="filterSelect" onchange="filterUsers()">
                        <option value="all">Tous</option>
                        <option value="avec-commandes">Avec commandes</option>
                        <option value="sans-commandes">Sans commandes</option>
                    </select>
                </div>
            </div>
            <div class="table-wrapper">
                <div id="usersContainer">
                    <div class="loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        Chargement des utilisateurs...
                    </div>
                </div>
            </div>
            <div class="pagination" id="pagination"></div>
        </div>

        <!-- ===== FOOTER ===== -->
        <div style="text-align:center; margin-top: 30px; color:#6c757d; font-size:0.8rem;">
            <p>© 2026 MAURILIVRES - Administration</p>
        </div>

    </div>

    <!-- ========================= SCRIPTS ========================= -->
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>

    <!-- Configuration Firebase -->
    <script src="js/firebase-config.js"></script>
    <!-- Authentification -->
    <script src="js/auth.js"></script>

    <script>
        // ============================================================
        // ÉTAT
        // ============================================================
        let allUsers = [];
        let filteredUsers = [];
        let currentPage = 1;
        const pageSize = 15;

        // ============================================================
        // CHARGEMENT DES DONNÉES
        // ============================================================
        async function loadUsers() {
            const container = document.getElementById('usersContainer');
            container.innerHTML = `
                    <div class="loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        Chargement des utilisateurs...
                    </div>
                `;

            try {
                const snapshot = await db.collection('users').orderBy('createdAt', 'desc').get();

                if (snapshot.empty) {
                    container.innerHTML = `
                            <div class="empty">
                                <i class="fas fa-users"></i>
                                <p>Aucun utilisateur inscrit pour le moment.</p>
                            </div>
                        `;
                    updateStats([]);
                    return;
                }

                allUsers = [];
                let totalOrders = 0;
                let totalFavorites = 0;
                let today = new Date();
                today.setHours(0, 0, 0, 0);
                let todayCount = 0;

                snapshot.forEach(doc => {
                    const data = doc.data();
                    const user = {
                        id: doc.id,
                        ...data
                    };
                    allUsers.push(user);

                    if (data.orders) totalOrders += data.orders.length;
                    if (data.favorites) totalFavorites += data.favorites.length;

                    if (data.createdAt) {
                        const createdDate = data.createdAt.toDate ? data.createdAt.toDate() : new Date(data
                        .createdAt);
                        createdDate.setHours(0, 0, 0, 0);
                        if (createdDate.getTime() === today.getTime()) {
                            todayCount++;
                        }
                    }
                });

                filteredUsers = [...allUsers];
                updateStats(allUsers, totalOrders, totalFavorites, todayCount);
                renderUsers();

            } catch (error) {
                console.error('Erreur:', error);
                container.innerHTML = `
                        <div class="empty" style="color:#dc3545;">
                            <i class="fas fa-exclamation-circle"></i>
                            <p>Erreur de chargement : ${error.message}</p>
                            <p style="font-size:0.8rem; margin-top:5px;">Vérifiez votre connexion Firebase</p>
                            <button onclick="loadUsers()" style="margin-top:15px; padding:8px 20px; background:#145daa; color:#fff; border:none; border-radius:8px; cursor:pointer;">
                                Réessayer
                            </button>
                        </div>
                    `;
            }
        }

        // ============================================================
        // MISE À JOUR DES STATS
        // ============================================================
        function updateStats(users, totalOrders, totalFavorites, todayCount) {
            const total = users.length || 0;
            document.getElementById('statUsers').textContent = total;
            document.getElementById('statOrders').textContent = totalOrders || 0;
            document.getElementById('statFavorites').textContent = totalFavorites || 0;
            document.getElementById('statToday').textContent = todayCount || 0;

            // Stats changement
            const usersChange = document.getElementById('statUsersChange');
            const ordersChange = document.getElementById('statOrdersChange');
            const favoritesChange = document.getElementById('statFavoritesChange');
            const todayChange = document.getElementById('statTodayChange');

            if (todayCount > 0) {
                usersChange.textContent = `+${todayCount} aujourd'hui`;
                usersChange.className = 'stat-change up';
                todayChange.textContent = '📈';
            } else {
                usersChange.textContent = '0 aujourd\'hui';
                usersChange.className = 'stat-change';
                todayChange.textContent = '📊';
            }

            if (totalOrders > 0) {
                ordersChange.textContent = `${totalOrders} commandes totales`;
                ordersChange.className = 'stat-change up';
            } else {
                ordersChange.textContent = 'Aucune commande';
                ordersChange.className = 'stat-change';
            }

            if (totalFavorites > 0) {
                favoritesChange.textContent = `${totalFavorites} favoris`;
                favoritesChange.className = 'stat-change up';
            } else {
                favoritesChange.textContent = 'Aucun favori';
                favoritesChange.className = 'stat-change';
            }
        }

        // ============================================================
        // AFFICHAGE DES UTILISATEURS
        // ============================================================
        function renderUsers() {
            const container = document.getElementById('usersContainer');
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;
            const pageUsers = filteredUsers.slice(start, end);

            if (pageUsers.length === 0) {
                container.innerHTML = `
                        <div class="empty">
                            <i class="fas fa-search"></i>
                            <p>Aucun utilisateur ne correspond à votre recherche.</p>
                        </div>
                    `;
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            let html = `
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Utilisateur</th>
                                <th>Téléphone</th>
                                <th>Inscrit le</th>
                                <th>Commandes</th>
                                <th>Favoris</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                    `;

            pageUsers.forEach((user, index) => {
                const num = start + index + 1;
                const date = user.createdAt ? (user.createdAt.toDate ? user.createdAt.toDate() : new Date(user
                    .createdAt)) : new Date();
                const formattedDate = date.toLocaleDateString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                const initials = user.name ? user.name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) :
                    '?';

                html += `
                        <tr>
                            <td>${num}</td>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar">${initials}</div>
                                    <div class="user-info">
                                        <span class="name">${user.name || 'Non renseigné'}</span>
                                        <span class="email">${user.email || 'Non renseigné'}</span>
                                    </div>
                                </div>
                            </td>
                            <td>${user.phone || 'Non renseigné'}</td>
                            <td>${formattedDate}</td>
                            <td>
                                <span class="badge badge-orders">${user.orders ? user.orders.length : 0}</span>
                            </td>
                            <td>${user.favorites ? user.favorites.length : 0}</td>
                            <td>
                                <button onclick="viewUser('${user.id}')" style="background:none; border:none; color:#145daa; cursor:pointer; font-size:1rem;" title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    `;
            });

            html += `
                        </tbody>
                    </table>
                `;

            container.innerHTML = html;
            renderPagination();
        }

        // ============================================================
        // PAGINATION
        // ============================================================
        function renderPagination() {
            const totalPages = Math.ceil(filteredUsers.length / pageSize);
            const pagination = document.getElementById('pagination');

            if (totalPages <= 1) {
                pagination.innerHTML = '';
                return;
            }

            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `
                        <button class="${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>
                    `;
            }
            pagination.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            renderUsers();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ============================================================
        // FILTRES
        // ============================================================
        function filterUsers() {
            const search = document.getElementById('searchInput').value.toLowerCase().trim();
            const filter = document.getElementById('filterSelect').value;

            filteredUsers = allUsers.filter(user => {
                // Filtre de recherche
                const matchSearch = !search ||
                    (user.name && user.name.toLowerCase().includes(search)) ||
                    (user.email && user.email.toLowerCase().includes(search)) ||
                    (user.phone && user.phone.toLowerCase().includes(search));

                // Filtre de statut
                let matchFilter = true;
                if (filter === 'avec-commandes') {
                    matchFilter = user.orders && user.orders.length > 0;
                } else if (filter === 'sans-commandes') {
                    matchFilter = !user.orders || user.orders.length === 0;
                }

                return matchSearch && matchFilter;
            });

            currentPage = 1;
            renderUsers();
        }

        // ============================================================
        // EXPORTER CSV
        // ============================================================
        function exportUsers() {
            if (allUsers.length === 0) {
                showToast('Aucun utilisateur à exporter', 'error');
                return;
            }

            const headers = ['ID', 'Nom', 'Email', 'Téléphone', 'Date d\'inscription', 'Commandes', 'Favoris'];
            const rows = allUsers.map(user => [
                user.id,
                user.name || '',
                user.email || '',
                user.phone || '',
                user.createdAt ? (user.createdAt.toDate ? user.createdAt.toDate().toISOString() : user.createdAt) : '',
                user.orders ? user.orders.length : 0,
                user.favorites ? user.favorites.length : 0
            ]);

            let csv = headers.join(',') + '\n';
            rows.forEach(row => {
                csv += row.map(cell => `"${cell}"`).join(',') + '\n';
            });

            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `utilisateurs_maurilivres_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(link.href);

            showToast(`✅ ${allUsers.length} utilisateurs exportés !`, 'success');
        }

        // ============================================================
        // VOIR UN UTILISATEUR
        // ============================================================
        function viewUser(uid) {
            const user = allUsers.find(u => u.id === uid);
            if (!user) {
                showToast('Utilisateur non trouvé', 'error');
                return;
            }

            const date = user.createdAt ? (user.createdAt.toDate ? user.createdAt.toDate() : new Date(user.createdAt)) :
                new Date();
            const formattedDate = date.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            let ordersHtml = '';
            if (user.orders && user.orders.length > 0) {
                ordersHtml = user.orders.map((order, i) => `
                        <div style="padding:6px 10px; background:#f8f9fa; border-radius:6px; margin-bottom:4px; font-size:0.8rem;">
                            <strong>Commande #${i+1}</strong> - ${order.date || 'Date non spécifiée'}
                            ${order.total ? `<span style="float:right; font-weight:600; color:#145daa;">${order.total} MRU</span>` : ''}
                        </div>
                    `).join('');
            } else {
                ordersHtml = '<div style="color:#6c757d; font-size:0.85rem;">Aucune commande</div>';
            }

            let favoritesHtml = '';
            if (user.favorites && user.favorites.length > 0) {
                favoritesHtml = user.favorites.map((fav, i) => `
                        <span style="display:inline-block; background:#e8f0fe; color:#145daa; padding:2px 10px; border-radius:12px; font-size:0.75rem; margin:2px;">
                            ${fav.title || fav || `Livre #${i+1}`}
                        </span>
                    `).join('');
            } else {
                favoritesHtml = '<div style="color:#6c757d; font-size:0.85rem;">Aucun favori</div>';
            }

            const modal = document.createElement('div');
            modal.style.cssText = `
                    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
                    backdrop-filter: blur(4px); z-index: 999999;
                    display: flex; align-items: center; justify-content: center;
                    padding: 20px; cursor: pointer;
                `;
            modal.innerHTML = `
                    <div style="background:#fff; border-radius:20px; max-width:600px; width:100%; max-height:90vh; overflow-y:auto; padding:30px; cursor:default; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
                        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #e9ecef; padding-bottom:15px; margin-bottom:20px;">
                            <h2 style="font-size:1.3rem; font-weight:700; color:#1a1a2e;">
                                <i class="fas fa-user" style="color:#145daa;"></i> ${user.name || 'Utilisateur'}
                            </h2>
                            <button onclick="this.closest('div[style]').remove()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:#6c757d;">&times;</button>
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                            <div><strong>Email</strong><br>${user.email || 'Non renseigné'}</div>
                            <div><strong>Téléphone</strong><br>${user.phone || 'Non renseigné'}</div>
                            <div><strong>Inscrit le</strong><br>${formattedDate}</div>
                            <div><strong>UID</strong><br><span style="font-size:0.7rem; color:#6c757d;">${user.id}</span></div>
                        </div>
                        <div style="margin-top:20px; padding-top:15px; border-top:1px solid #e9ecef;">
                            <h3 style="font-size:1rem; font-weight:600; margin-bottom:8px;"><i class="fas fa-shopping-bag" style="color:#145daa;"></i> Commandes (${user.orders ? user.orders.length : 0})</h3>
                            ${ordersHtml}
                        </div>
                        <div style="margin-top:15px;">
                            <h3 style="font-size:1rem; font-weight:600; margin-bottom:8px;"><i class="fas fa-heart" style="color:#e74c3c;"></i> Favoris (${user.favorites ? user.favorites.length : 0})</h3>
                            <div style="display:flex; flex-wrap:wrap; gap:4px;">${favoritesHtml}</div>
                        </div>
                    </div>
                `;
            modal.addEventListener('click', function(e) {
                if (e.target === modal) modal.remove();
            });
            document.body.appendChild(modal);
        }

        // ============================================================
        // AFFICHER UN TOAST
        // ============================================================
        function showToast(message, type = 'info') {
            const old = document.querySelector('.toast-admin');
            if (old) old.remove();

            const toast = document.createElement('div');
            toast.className = `toast-admin ${type}`;
            toast.textContent = message;
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(function() {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }

        // ============================================================
        // RAFRAÎCHIR
        // ============================================================
        function refreshData() {
            showToast('🔄 Actualisation en cours...', 'info');
                console.log("✅ Admin authentifié sur Firefox, chargement...");
            loadUsers();
        }

        // ============================================================
        // DÉCONNEXION ADMIN
        // ============================================================
        function logoutAdmin() {
            if (confirm('Êtes-vous sûr de vouloir vous déconnecter ?')) {
                auth.signOut().then(() => {
                    window.location.href = 'index.html';
                }).catch((error) => {
                    showToast('Erreur lors de la déconnexion', 'error');
                });
            }
        }

        // ============================================================
        // SÉCURITÉ - VÉRIFICATION ADMIN
        // ============================================================
        auth.onAuthStateChanged(async (user) => {
            if (!user) {
                // Rediriger vers l'accueil si non connecté
                showToast('🔐 Veuillez vous connecter', 'error');
                setTimeout(function() {
                    window.location.href = 'index.html';
                }, 2500);
                return;
            }

            // Vérifier que l'utilisateur est admin
            try {
                const doc = await db.collection('users').doc(user.uid).get();
                if (doc.exists && doc.data().role === 'admin') {
                    // Charger les données
                console.log("✅ Admin authentifié sur Firefox, chargement...");
                    loadUsers();
                    showToast('👋 Bienvenue administrateur !', 'success');
                } else {
                    // Pas admin
                    showToast('⛔ Accès non autorisé', 'error');
                    setTimeout(function() {
                        window.location.href = 'index.html';
                    }, 2500);
                }
            } catch (error) {
                console.error('Erreur vérification admin:', error);
                // Si l'utilisateur n'a pas de document, on le redirige
                showToast('⛔ Accès non autorisé', 'error');
                setTimeout(function() {
                    window.location.href = 'index.html';
                }, 2500);
            }
        });

        // ============================================================
        // EXPOSER LES FONCTIONS GLOBALEMENT
        // ============================================================
        window.loadUsers = loadUsers;
        window.exportUsers = exportUsers;
        window.filterUsers = filterUsers;
        window.viewUser = viewUser;
        window.goToPage = goToPage;
        window.refreshData = refreshData;
        window.logoutAdmin = logoutAdmin;
        window.showToast = showToast;
    </script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (typeof updateAuthUI === "function") {
            updateAuthUI();
        }
    });
</script>
</body>
</html>
